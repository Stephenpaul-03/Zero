{
  "name": "zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite",
    "build": "node scripts/prepare.mjs && tsc -b && vite build && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview --host 127.0.0.1",
    "dev:editor": "node scripts/prepare.mjs && vite --mode admin",
    "test": "node --test tests/*.test.mjs",
    "verify:content": "node scripts/verify.mjs",
    "migrate": "node scripts/migrate.mjs",
    "admin": "node scripts/prepare.mjs && vite --mode admin",
    "check": "npm run lint && npm test && npm run verify:content && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.536.0",
    "marked": "^18.0.5",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  },
  "description": "Notes, hardware builds, and software project documentation",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
